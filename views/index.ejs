<!--Shared header and navigation-->
<%- include partials/header.ejs %>
<%- include partials/main_nav.ejs %>
<!--Container for the home page-->
  <div class="container mt-5 mb-5 pb-5">
 
    <div class="row align-items-center g-4">
      <!--Inserting an image of myself to the left side-->
      <div class="col-md-4 text-center">
        <img src="/Images/meimage.jpg" alt="Profile Picture" class="img-fluid rounded-4">
      </div>
      <!--Directory with links to the other portfolio with short descriptions-->
      <div class="col-md-8">
          <div class="row">
              <div class="text-center mb-4">
                <h1>Welcome to my portfolio!</h1>
              </div>
            <!--Link to about me-->
            <div class="col align-self-start">
              <div class="card-body text-center">
                <h4 class="card-title">ABOUT ME</h4>
                <p class="card-text">My education, intresets, skills</p>
                <a href ="/about" class=" btn btn-primary btn-sm">Learn more</a>
              </div>
            </div>
            <!--Link to my projects-->
            <div class="col align-self-center">
              <div class="card-body text-center">
                <h4 class="card-title">MY PROJECTS</h4>
                <p class="card-text">Some projects I have worked on.</p>
                <a href ="/projects" class=" btn btn-primary btn-sm">Learn more</a>
              </div>
            </div>
            <!--link to contact page-->
            <div class="col align-self-end">
              <div class="card-body text-center">
                <h4 class="card-title">CONTACT ME</h4>
                <p class="card-text">Have any questions or comments?</p>
                <a href ="/contact" class="btn btn-primary btn-sm">Learn more</a>
              </div>
            </div>
          </div>
      </div>
    </div>
  </div>
<!--Shared footer-->
<%- include partials/footer.ejs %>   
