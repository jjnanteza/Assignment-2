<!-- Adding the header and nav bar to the top of the about page-->
<%- include partials/header.ejs %>
<%- include partials/main_nav.ejs %>

<!--Container for the about me page content-->
<div class="container mt-4 mb-4">
    <div class="text-center mb-3">
        <h1><%= title %></h1>
        <p class="lead">My academic background, interests and skills.</p>
    </div>
    <!--Introduction about me-->
    <div class="row g-4">
        <!--Card to displaye personal and academic background-->
        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h2 class="card-title">Who I Am</h2>
                    <p class="mb-5">
                        My name is Janice and I am a student at Ontario Tech University, pursing a Bachelors degree in Networking and IT Security.
                    </p>
                    
                    <p class="mb-5">
                        Throughout my studies i have been developing an understanding of computer systems, networking, programming and Information security.
                    </p>
                    
                    <p class="mb-0">
                        I enjoy learning how computer systems work, solving technical problems, and developing my skills with practical projects.
                    </p>
                </div>
            </div>
        </div>
        <!-- Card for skills and interests -->
        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h2 class="card-title">My Interests & Skills</h2>
                    <!--List of some skills-->
                    <p> Throughout my coursework and personal learning I have been developing skills in:</p>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item">Networking</li>
                        <li class="list-group-item">Python Programming </li>
                        <li class="list-group-item">HTML, CSS, and JavaScript</li>
                        <li class="list-group-item">Problem Solving and Troubleshooting</li>
                        <li class="list-group-item">Communication and Customer service</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<!--Shared footer-->
<%- include partials/footer.ejs %>   